OPENAI_API_KEY=
# Set to "true" to show the AI chat widget (requires OpenAI billing/credits)
CHAT_ENABLED=false
DATABASE_URL="postgresql://USER:PASSWORD@HOST/revstay?sslmode=require&uselibpqcompat=true"

# Auth.js — generate AUTH_SECRET with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth (optional) — leave blank to disable the Google sign-in button
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (transactional email). Without a verified domain, use
# "onboarding@resend.dev" (only delivers to your Resend account email).
RESEND_API_KEY=
BOOKING_FROM_EMAIL="Revstay <onboarding@resend.dev>"
